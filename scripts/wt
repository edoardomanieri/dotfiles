#!/usr/bin/env bash

typeset -g WT_PREVIOUS_BRANCH=""
typeset -g WT_SOURCE_REF=""

_wt_repo_dir() {
  if [[ -n "${WT_REPO_DIR:-}" ]]; then
    echo "$WT_REPO_ DIR"
  else
    echo "/Users/eman/projects/jethr"
  fi
}

_wt_dirty() {
  [[ -n "$(git status --short)" ]]
}

_wt_require_clean() {
  if _wt_dirty; then
    echo "wt interrotto: il working tree deve essere pulito."
    git status --short
    return 1
  fi
}

_wt_staged_command() {
  case "$1" in
    lint-staged|*-staged) return 0 ;;
    *) return 1 ;;
  esac
}

_wt_merge_base() {
  git merge-base main "$WT_SOURCE_REF"
}

_wt_prepare_staged_diff() {
  local base_ref

  base_ref="$(_wt_merge_base)" || return 1
  git reset --hard "$base_ref" || return 1

  if git diff --quiet "$base_ref" "$WT_SOURCE_REF"; then
    return 0
  fi

  git diff --binary "$base_ref" "$WT_SOURCE_REF" | git apply --index
}

_wt_has_output_changes() {
  ! git diff --quiet "$WT_SOURCE_REF" || [[ -n "$(git ls-files --others --exclude-standard)" ]]
}

wt-up() {
  local current_branch
  local repo_dir

  current_branch="$(git branch --show-current)"
  if [[ -z "$current_branch" ]]; then
    echo "Non riesco a determinare il branch corrente."
    return 1
  fi

  if [[ "$current_branch" == "eman/local-test" ]]; then
    if [[ -z "$WT_PREVIOUS_BRANCH" ]]; then
      echo "wt-up interrotto: sei gia' su eman/local-test ma WT_PREVIOUS_BRANCH e' vuota."
      return 1
    fi

    wt-down || return 1
    current_branch="$(git branch --show-current)"
  fi

  _wt_require_clean || return 1

  WT_PREVIOUS_BRANCH="$current_branch"
  WT_SOURCE_REF="$(git rev-parse HEAD)"

  repo_dir="$(_wt_repo_dir)"
  cd "$repo_dir" || return 1

  wt switch main &&
    git checkout eman/local-test &&
    git reset --hard "$WT_SOURCE_REF"
}

wt-down() {
  if [[ "$(git branch --show-current)" != "eman/local-test" ]]; then
    echo "Il branch corrente deve essere eman/local-test."
    return 1
  fi

  if [[ -z "$WT_PREVIOUS_BRANCH" ]]; then
    echo "Non ho un branch precedente salvato in WT_PREVIOUS_BRANCH."
    return 1
  fi

  if ! _wt_require_clean; then
    echo "wt-down interrotto: usa wt-move per riportare le modifiche sul branch originale, oppure sistemale manualmente."
    return 1
  fi

  git checkout main && wt switch "$WT_PREVIOUS_BRANCH"
}

wt-run() {
  local command_name
  local command_status
  local staged=0

  command_name="${1:-}"
  if [[ -z "$command_name" ]]; then
    echo "Uso: wt-run <dev-tools-command> [args...]"
    return 1
  fi

  _wt_staged_command "$command_name" && staged=1

  wt-up || return 1
  if [[ "$staged" -eq 1 ]]; then
    _wt_prepare_staged_diff || return 1
  fi

  ./dev-tools.sh "$@"
  command_status=$?

  if _wt_has_output_changes; then
    echo "wt-run ha lasciato modifiche su eman/local-test."
    echo "Per riportarle sul branch originale esegui: wt-move"
    return "$command_status"
  fi

  git reset --hard "$WT_SOURCE_REF" || return 1
  wt-down || return 1
  return "$command_status"
}

wt-move() {
  if [[ "$(git branch --show-current)" != "eman/local-test" ]]; then
    echo "Il branch corrente deve essere eman/local-test."
    return 1
  fi

  if [[ -z "$WT_PREVIOUS_BRANCH" || -z "$WT_SOURCE_REF" ]]; then
    echo "Manca il contesto di wt-run: WT_PREVIOUS_BRANCH o WT_SOURCE_REF vuota."
    return 1
  fi

  if ! _wt_has_output_changes; then
    echo "Non ci sono modifiche da spostare."
    return 0
  fi

  git reset --mixed "$WT_SOURCE_REF" || return 1
  git stash push -u -m "wt-move $WT_PREVIOUS_BRANCH" || return 1
  wt-down || return 1
  git stash pop
}
