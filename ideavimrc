" Source your .vimrc
source ~/.vimrc

" -- Map IDE actions to IdeaVim -- https://jb.gg/abva4t
map <leader>d <Action>(GotoDeclaration)
map <leader>n <Action>(GotoFile)
map <leader>e <Action>(SearchEverywhere)
map <leader>r <Action>(RenameElement)
map <leader>w <Action>(Switcher)
map <leader>fs <Action>(FileStructurePopup)
map <leader>cp <Action>(CopySourceRootPath)
map <leader>rb <Action>(Vcs.RollbackChangedLines)
map <leader>cwb <Action>(Git.CompareWithBranch)
map <Leader>pf <action>(com.mituuz.fuzzier.Fuzzier)
map <leader>sd <Action>(Diff.ShowDiff)
map <leader>lc <Action>(CommentByLineComment)

set surrond

" Find more examples here: https://jb.gg/share-ideavimrc
